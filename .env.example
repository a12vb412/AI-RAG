# Database Configuration (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rag_app_db?schema=public"

# OpenAI API Key (Embeddings & Chat completions)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Model Configurations
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Chunking Hyperparameters
RAG_CHUNK_SIZE="800"
RAG_CHUNK_OVERLAP="150"
RAG_SIMILARITY_TOP_K="5"
RAG_SIMILARITY_THRESHOLD="0.45"

# NextAuth / Authentication
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Optional Alternative Provider: Google Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio App Runtime URL
APP_URL="MY_APP_URL"

