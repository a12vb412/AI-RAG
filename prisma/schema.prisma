// Prisma Schema for Multi-Tenant AI Document Q&A (RAG)
// Features pgvector extension, CASCADE deletes to prevent orphan embeddings,
// and private workspace isolation.

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  passwordHash  String?
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspaces    WorkspaceMember[]
  ownedSpaces   Workspace[]       @relation("WorkspaceOwner")
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  documents   Document[]
  chats       ChatSession[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Document {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  fileType     String          // "pdf", "txt", "md"
  fileSize     Int             // bytes
  pageCount    Int             @default(1)
  status       DocumentStatus  @default(PENDING)
  errorMessage String?
  checksum     String?         // SHA-256 hash to prevent duplicate reprocessing
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  chunks       DocumentChunk[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model DocumentChunk {
  id          String                                  @id @default(cuid())
  documentId  String
  document    Document                                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspaceId String
  chunkIndex  Int
  content     String                                  @db.Text
  pageNumber  Int?
  tokenCount  Int
  metadata    Json?                                   // { startChar, endChar, heading, keywords }
  embedding   Unsupported("vector(1536)")?            // OpenAI text-embedding-3-small (1536 dim)
  createdAt   DateTime                                @default(now())
  citations   Citation[]

  @@index([workspaceId])
  @@index([documentId])
  @@index([documentId, chunkIndex])
}

model ChatSession {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String        @default("New Conversation")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@index([workspaceId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String      @db.Text
  tokenUsage Int?
  createdAt  DateTime    @default(now())
  citations  Citation[]

  @@index([sessionId])
}

model Citation {
  id              String         @id @default(cuid())
  messageId       String
  message         ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunkId         String?
  chunk           DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  documentId      String
  documentName    String
  pageNumber      Int?
  similarityScore Float
  snippet         String         @db.Text
  createdAt       DateTime       @default(now())

  @@index([messageId])
  @@index([chunkId])
  @@index([documentId])
}
